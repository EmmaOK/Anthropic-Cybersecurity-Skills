{
  "mcpServers": {
    "phantom-skills": {
      "command": "python3",
      "args": ["mcp/phantom_mcp_server.py"]
    },
    "cve-intel": {
      "command": "python3",
      "args": ["-m", "cve_mcp.server"]
    },
    "dast": {
      "command": "python3",
      "args": ["mcp/dast_mcp_server.py"],
      "env": {
        "ZAP_URL": "http://localhost:8080",
        "ZAP_API_KEY": "",
        "BURP_URL": "http://localhost:1337",
        "BURP_API_KEY": ""
      }
    },
    "burp-pentest": {
      "command": "python3",
      "args": ["mcp/burp_pentest_mcp_server.py"],
      "env": {
        "PHANTOM_BURP_URL": "http://127.0.0.1:9877"
      }
    },
    "infra": {
      "command": "python3",
      "args": ["mcp/infra_mcp_server.py"]
    },
    "defectdojo": {
      "command": "python3",
      "args": ["mcp/defectdojo_mcp_server.py"],
      "env": {
        "DEFECTDOJO_URL": "http://localhost:8080",
        "DEFECTDOJO_API_KEY": ""
      }
    },
    "jira": {
      "command": "python3",
      "args": ["mcp/jira_mcp_server.py"],
      "env": {
        "JIRA_URL": "",
        "JIRA_USER": "",
        "JIRA_TOKEN": "",
        "JIRA_PROJECT_KEY": "SEC"
      }
    }
  }
}
